<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Separator?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="App.HelloController"
            prefWidth="900"
            prefHeight="600"
            styleClass="root-pane"
            stylesheets="@landing.css">


    <center>
        <ScrollPane fitToWidth="true"
                    fitToHeight="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    styleClass="body-scroll">
            <StackPane styleClass="body-pane">
                <VBox styleClass="card" spacing="10" maxWidth="420">

                <VBox fx:id="sessionPane" spacing="10">
                    <Label text="Welcome back" styleClass="card-title"/>
                    <Label text="Start writing or join an existing session." styleClass="card-sub"/>

                    <HBox spacing="8">
                        <TextField fx:id="newDocNameField"
                                   promptText="Document name"
                                   styleClass="join-input"
                                   HBox.hgrow="ALWAYS"/>
                        <Button fx:id="newDocButton"
                                text="New document"
                                onAction="#newDoc"
                                styleClass="btn-primary"
                                minWidth="120"/>
                    </HBox>

                    <Button fx:id="importButton"
                            text="Import document (.txt)"
                            onAction="#importDoc"
                            styleClass="btn-secondary"
                            maxWidth="Infinity"/>

                    <Button text="Browse documents"
                            styleClass="btn-secondary"
                            maxWidth="Infinity"/>

                    <HBox styleClass="divider-row" alignment="CENTER" spacing="10">
                        <Separator HBox.hgrow="ALWAYS"/>
                        <Label text="or join with a code" styleClass="divider-label"/>
                        <Separator HBox.hgrow="ALWAYS"/>
                    </HBox>

                    <HBox spacing="8">
                        <TextField fx:id="sessionCodeField"
                                   promptText="Session code"
                                   styleClass="join-input"
                                   HBox.hgrow="ALWAYS"/>
                        <Button fx:id="joinButton"
                                text="Join session"
                                onAction="#joinSession"
                                styleClass="btn-secondary"
                                minWidth="110"/>
                    </HBox>

                    <Button fx:id="showSignupButton"
                            text="Create account"
                            onAction="#showSignup"
                            styleClass="btn-link"
                            maxWidth="Infinity"/>
                    <Button fx:id="showLoginButton"
                            text="Log in"
                            onAction="#showLogin"
                            styleClass="btn-link"
                            maxWidth="Infinity"/>
                </VBox>

                <VBox fx:id="loginPane" spacing="10" visible="false" managed="false" styleClass="auth-pane">
                    <Label text="Log in" styleClass="card-title"/>
                    <Label text="Use your local profile to continue into the workspace." styleClass="card-sub"/>

                    <TextField fx:id="loginUsernameField"
                               promptText="Username"
                               styleClass="join-input"/>
                    <PasswordField fx:id="loginPasswordField"
                                   promptText="Password"
                                   styleClass="join-input"/>

                    <Label fx:id="loginStatusLabel" text="" styleClass="status-label"/>

                    <Button fx:id="loginAccountButton"
                            text="Log in"
                            onAction="#loginAccount"
                            styleClass="btn-primary"
                            maxWidth="Infinity"/>
                    <Button fx:id="backFromLoginButton"
                            text="Back to session tools"
                            onAction="#showSessionPane"
                            styleClass="btn-secondary"
                            maxWidth="Infinity"/>
                </VBox>

                <VBox fx:id="signupPane" spacing="10" visible="false" managed="false" styleClass="auth-pane">
                    <Label text="Create account" styleClass="card-title"/>
                    <Label text="Set up your profile before starting a document." styleClass="card-sub"/>

                    <TextField fx:id="signupNameField"
                               promptText="Full name"
                               styleClass="join-input"/>
                    <TextField fx:id="signupUsernameField"
                               promptText="Username"
                               styleClass="join-input"/>
                    <PasswordField fx:id="signupPasswordField"
                                   promptText="Password"
                                   styleClass="join-input"/>
                    <PasswordField fx:id="signupConfirmPasswordField"
                                   promptText="Confirm password"
                                   styleClass="join-input"/>

                    <Label fx:id="signupStatusLabel" text="" styleClass="status-label"/>

                    <Button fx:id="createAccountButton"
                            text="Create account"
                            onAction="#createAccount"
                            styleClass="btn-primary"
                            maxWidth="Infinity"/>
                    <Button fx:id="backToSessionButton"
                            text="Back to session tools"
                            onAction="#showSessionPane"
                            styleClass="btn-secondary"
                            maxWidth="Infinity"/>
                </VBox>

                </VBox>
            </StackPane>
        </ScrollPane>
    </center>

</BorderPane>
