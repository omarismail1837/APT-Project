<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import org.fxmisc.richtext.StyleClassedTextArea?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="App.BlankController"
            prefWidth="1220" prefHeight="760"
            style="-fx-background-color: #121212; -fx-padding: 15;">

    <center>
        <VBox VBox.vgrow="ALWAYS" fillWidth="true" style="-fx-background-color: #1e1e1e; -fx-background-radius: 8; -fx-border-color: #333; -fx-border-radius: 8; -fx-border-width: 1;">

            <HBox alignment="CENTER_LEFT" spacing="12" minHeight="58" style="-fx-padding: 10 20; -fx-border-color: transparent transparent #333 transparent; -fx-border-width: 1;">

                <HBox alignment="CENTER_LEFT" spacing="12" minWidth="150" prefWidth="210" maxWidth="240">
                    <VBox alignment="CENTER_LEFT" minWidth="0">
                        <Label fx:id="nameLabel" text="documents.txt" textOverrun="ELLIPSIS" maxWidth="220" style="-fx-text-fill: #e0e0e0; -fx-font-weight: bold; -fx-font-size: 13;"/>
                        <!--                        <Label fx:id="docIdLabel" maxWidth="330" style="-fx-text-fill: #666; -fx-font-family: 'monospace'; -fx-font-size: 10;" />-->
                    </VBox>
                </HBox>

                <Separator orientation="VERTICAL" prefHeight="25" style="-fx-opacity: 0.1;"/>

                <VBox alignment="CENTER_LEFT" spacing="4" minWidth="360" prefWidth="430" maxWidth="520" HBox.hgrow="ALWAYS">
                    <!-- Edit Code Row -->
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label fx:id="editCodeLabel"
                               textOverrun="ELLIPSIS"
                               maxWidth="450"
                               style="-fx-text-fill: #4ade80; -fx-font-family: 'monospace'; -fx-font-size: 11;" />
                        <Button text="⮺" onAction="#copyEditCode"
                                style="-fx-font-size: 10; -fx-padding: 1 5; -fx-background-color: transparent; -fx-text-fill: #4ade80; -fx-border-color: #4ade80; -fx-border-radius: 3; -fx-background-radius: 3; -fx-cursor: hand; -fx-opacity: 0.8;" />
                    </HBox>

                    <!-- View Code Row -->
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label fx:id="viewCodeLabel"
                               textOverrun="ELLIPSIS"
                               maxWidth="450"
                               style="-fx-text-fill: #93c5fd; -fx-font-family: 'monospace'; -fx-font-size: 11;" />
                        <Button text="⮺" onAction="#copyViewCode"
                                style="-fx-font-size: 10; -fx-padding: 1 5; -fx-background-color: transparent; -fx-text-fill: #93c5fd; -fx-border-color: #93c5fd; -fx-border-radius: 3; -fx-background-radius: 3; -fx-cursor: hand; -fx-opacity: 0.8;" />
                    </HBox>
                </VBox>

                <Region HBox.hgrow="ALWAYS" />

                <HBox spacing="8" alignment="CENTER_RIGHT" minWidth="470">
                    <HBox spacing="4">
                        <Button fx:id="boldButton" onAction="#toggleBold" text="B" styleClass="btn-format" style="-fx-font-weight: bold;"/>
                        <Button fx:id="italicButton" onAction="#toggleItalic" text="I" styleClass="btn-format" style="-fx-font-style: italic;"/>
                    </HBox>

                    <Separator orientation="VERTICAL" prefHeight="20" style="-fx-opacity: 0.1;"/>

                    <HBox spacing="6">
                        <Button fx:id="undoButton" text="Undo" onAction="#undo" styleClass="btn-action" minWidth="64"/>
                        <Button fx:id="redoButton" text="Redo" onAction="#redo" styleClass="btn-action" minWidth="64"/>
                        <Button fx:id="exportButton" text="Export" onAction="#exportDocument" styleClass="btn-action" minWidth="74" style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-border-color: #2563eb;"/>
                        <Button fx:id="saveVersionButton" text="Save Version" onAction="#saveVersion" styleClass="btn-action" minWidth="106" style="-fx-background-color: #22c55e; -fx-text-fill: white; -fx-border-color: #16a34a;"/>
                        <Button fx:id="historyButton" text="History" onAction="#showHistory" styleClass="btn-action" minWidth="78" style="-fx-background-color: #8b5cf6; -fx-text-fill: white; -fx-border-color: #7c3aed;"/>
                    </HBox>
                </HBox>
            </HBox>

            <!-- Main Content Area -->
            <HBox VBox.vgrow="ALWAYS">
                <StyleClassedTextArea fx:id="textArea" VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS"
                                      wrapText="true"
                                      styleClass="styled-text-area"/>

                <!-- Right Sidebar (User List + Back Button) -->
                <VBox prefWidth="220" spacing="15" style="-fx-padding: 20; -fx-border-color: transparent transparent transparent #333; -fx-border-width: 1; -fx-background-color: #1a1a1a;">
                    <Label text="ACTIVE USERS" style="-fx-text-fill: #666; -fx-font-size: 10; -fx-font-weight: bold; -fx-letter-spacing: 1;"/>

                    <!-- Users growable area -->
                    <VBox fx:id="activeUsersBox" spacing="12" VBox.vgrow="ALWAYS"/>

                    <!-- Spacer to push button to the bottom -->
                    <Region VBox.vgrow="ALWAYS" />

                    <Button text="← Back to Dashboard"
                            onAction="#handleBack"
                            maxWidth="Infinity"
                            style="-fx-background-color: transparent; -fx-text-fill: #94a3b8; -fx-border-color: #334155; -fx-border-radius: 5; -fx-cursor: hand; -fx-padding: 8; -fx-font-size: 12;"/>
                </VBox>
            </HBox> <!-- End of main content HBox -->

            <!-- Bottom Status Bar -->
            <HBox spacing="20" alignment="CENTER_LEFT" style="-fx-padding: 8 15; -fx-background-color: #161616; -fx-background-radius: 0 0 8 8;">
                <Label fx:id="lineColLabel" text="Line 1, Col 1" style="-fx-text-fill: #555; -fx-font-size: 11;"/>
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="connectedLabel" text="1 editors connected" style="-fx-text-fill: #555; -fx-font-size: 11;"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>