<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.shape.Circle?>
<?import javafx.geometry.Insets?>

<?import org.fxmisc.richtext.StyleClassedTextArea?>
<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="App.BlankController"
            prefWidth="900" prefHeight="600"
            style="-fx-background-color: #121212; -fx-padding: 15;">

    <center>
        <VBox style="-fx-background-color: #1e1e1e; -fx-background-radius: 8; -fx-border-color: #333; -fx-border-radius: 8; -fx-border-width: 1;">

            <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-padding: 15; -fx-border-color: transparent transparent #333 transparent; -fx-border-width: 1;">
                <Label text="my-document.txt" style="-fx-text-fill: #e0e0e0; -fx-font-weight: bold; -fx-font-size: 14;"/>

                <Separator orientation="VERTICAL" prefHeight="20" style="-fx-opacity: 0.2;"/>

                <HBox spacing="5">
                    <Button fx:id="boldButton"
                            onAction="#toggleBold"
                            text="B"
                            style="-fx-background-color: #2a2a2a;
                            -fx-text-fill: white;
                            -fx-font-weight: bold;
                            -fx-cursor: hand;"/>
                    <Button fx:id="italicButton"
                            onAction="#toggleItalic"
                            text="I"
                            style="-fx-background-color: #2a2a2a; -fx-text-fill: white; -fx-font-style: italic; -fx-cursor: hand;"/>
                </HBox>

                <Region HBox.hgrow="ALWAYS" /> <HBox spacing="10">
                <Button text="Export" style="-fx-background-color: transparent; -fx-border-color: #444; -fx-border-radius: 4; -fx-text-fill: #ccc;"/>
                <Button text="Undo" style="-fx-background-color: transparent; -fx-border-color: #444; -fx-border-radius: 4; -fx-text-fill: #ccc;"/>
                <Button text="Redo" style="-fx-background-color: transparent; -fx-border-color: #444; -fx-border-radius: 4; -fx-text-fill: #ccc;"/>
            </HBox>
            </HBox>

            <HBox VBox.vgrow="ALWAYS">
                <StyleClassedTextArea fx:id="textArea" VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS"
                          wrapText="true"
                          style="-fx-control-inner-background: #1e1e1e; -fx-text-fill: #d4d4d4; -fx-display-caret: true; -fx-background-color: transparent; -fx-focus-color: transparent;
                          -fx-text-box-border: transparent; -fx-font-family: 'ui-sans-serif'; -fx-font-size: 15;  -fx-prompt-text-fill: gray;"/>

                <VBox spacing="15" prefWidth="200" style="-fx-padding: 20; -fx-border-color: transparent transparent transparent #333; -fx-border-width: 1;">
                    <Label text="ACTIVE USERS" style="-fx-text-fill: #888; -fx-font-size: 11; -fx-font-weight: bold; -fx-letter-spacing: 1;"/>

                    <VBox spacing="10">
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Circle radius="4" fill="#ff5f56"/>
                            <Label text="You" style="-fx-text-fill: #e0e0e0;"/>
                        </HBox>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Circle radius="4" fill="#3b82f6"/>
                            <Label text="Nada" style="-fx-text-fill: #e0e0e0;"/>
                        </HBox>
                        <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-opacity: 0.5;">
                            <Circle radius="4" fill="#666"/>
                            <Label text="offline" style="-fx-text-fill: #888; -fx-font-style: italic;"/>
                        </HBox>
                    </VBox>
                </VBox>
            </HBox>

            <HBox spacing="20" style="-fx-padding: 8 15; -fx-background-color: #1a1a1a; -fx-background-radius: 0 0 8 8;">
                <Label text="Line 3, Col 12" style="-fx-text-fill: #666; -fx-font-size: 11;"/>
                <Label text="2 editors connected" style="-fx-text-fill: #666; -fx-font-size: 11;"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>